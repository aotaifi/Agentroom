FROM localhost/agent-pods-base:0.1
USER root
COPY images/chatty/requirements.txt /opt/chatty/requirements.txt
RUN pip install --no-cache-dir -r /opt/chatty/requirements.txt
# This directory is staged privately on the build host, never committed.
COPY .private/vendor/nqsmagic /opt/vendor/nqsmagic
RUN pip install --no-cache-dir --no-deps /opt/vendor/nqsmagic \
    && pip check \
    && pip freeze > /opt/chatty/resolved-requirements.txt
USER 1000:1000
